{
  "name": "workspace",
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "lint:report": "node scripts/lint-report.mjs",
    "format": "prettier --write \"artifacts/*/src/**/*.{ts,tsx}\" \"artifacts/*/scripts/**/*.mjs\" \"lib/*/src/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"artifacts/*/src/**/*.{ts,tsx}\" \"artifacts/*/scripts/**/*.mjs\" \"lib/*/src/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "audit": "pnpm audit --prod"
  },
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.27.3",
    "@rollup/rollup-win32-x64-msvc": "^4.61.1",
    "@tailwindcss/oxide-win32-x64-msvc": "*",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
